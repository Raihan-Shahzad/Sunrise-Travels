generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Enquiry {
  id        String   @id @default(cuid())
  type      String   // flight, hajj, umrah, nadra, visa, passport, contact
  name      String
  email     String
  phone     String
  data      String   // JSON string of form-specific fields
  createdAt DateTime @default(now())
}
